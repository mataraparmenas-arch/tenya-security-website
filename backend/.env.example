DJANGO_SECRET_KEY=django-insecure-k87*u8p&=#9_sf3b#q-h-hj-ds4^7yjl)!eq+e%lu2u)jcdnx$
DEBUG=True
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost
# Local `python manage.py` commands use SQLite by default. Docker Compose
# overrides this to `postgres` for the backend service.
DATABASE_MODE=sqlite
SQLITE_DATABASE_NAME=db.sqlite3

# Used only when DATABASE_MODE=postgres (including Docker Compose).
DATABASE_ENGINE=postgresql_psycopg2
DATABASE_NAME=open-sacco-db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=5432

# Postgres specific variables for the db service
POSTGRES_DB=open-sacco-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# Google app email and password for sending emails
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD='nnxp gcdl kyyn bagg'

# --- Self-hosting additions (MGR001) ---
# Comma-separated public domains for the API host (added to ALLOWED_HOSTS)
DJANGO_ALLOWED_HOSTS=sacco-api.onrender.com
# Comma-separated frontend origins allowed to call the API (CORS + CSRF)
CORS_EXTRA_ORIGINS=https://sacco-web.vercel.app
# Single-URL database connection from your Postgres provider (Render, Neon...)
# Overrides DATABASE_MODE when set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- M-Pesa Daraja (get keys at developer.safaricom.co.ke) ---
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
